{
  "ClientOrigin": "https://localhost:7227",
  "Authentication": {
    "Required": true,
    "TenantId": "00000000-0000-0000-0000-000000000000",
    "Audience": "api://replace-with-api-app-id",
    "Authority": ""
  },
  "Foundry": {
    "Provider": "Sample",
    "Endpoint": "",
    "TenantId": "00000000-0000-0000-0000-000000000000",
    "SubscriptionId": "00000000-0000-0000-0000-000000000000",
    "AllowedTenantIds": [],
    "AllowedSubscriptionIds": [],
    "TenantIdQueryParameterName": "tenantId",
    "SubscriptionIdQueryParameterName": "subscriptionId",
    "TenantIdHeaderName": "x-ms-tenant-id",
    "SubscriptionIdHeaderName": "x-ms-subscription-id",
    "IncludeTenantSubscriptionInQuery": true,
    "IncludeTenantSubscriptionInHeaders": true,
    "EntraScope": "https://management.azure.com/.default",
    "ProjectsPath": "/projects",
    "BillingPathTemplate": "/projects/{projectId}/billing?period={period}",
    "CacheSeconds": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
